# Copy this file to .env and fill in what you need.

# Port the server listens on
PORT=3001

# Public site name / domain used in page titles and meta tags
SITE_NAME=InstaSaver
SITE_URL=http://localhost:3001

# OPTIONAL. Instagram sessionid cookie of a throwaway account.
# Public posts and reels usually resolve without it, but Instagram rate-limits
# anonymous requests hard and stories are ONLY available when authenticated.
# Get it from your browser: DevTools > Application > Cookies > instagram.com > sessionid
IG_SESSIONID=

# OPTIONAL. Instagram csrftoken cookie, used together with IG_SESSIONID.
IG_CSRFTOKEN=

# Requests per minute allowed per IP address on /api/fetch
RATE_LIMIT_PER_MINUTE=20

# Seconds a resolved post is kept in the in-memory cache
CACHE_TTL_SECONDS=900

# ffmpeg is provided automatically by the `ffmpeg-static` npm package (bundled
# in node_modules), so the /audio page's MP3 extraction works with no system
# install. Leave empty to use the bundled binary; set an explicit path only if
# you want to override it with your own ffmpeg build.
FFMPEG_PATH=

# MP3 bitrate used for extracted audio.
AUDIO_BITRATE=192k

# yt-dlp is provided automatically by the `yt-dlp-exec` npm package (bundled in
# node_modules), so no path is needed here. It is REQUIRED for reels/videos to
# download as MP4 — Instagram no longer serves the video URL to anonymous
# embed pages. Leave empty unless you specifically want to override the
# bundled binary with your own path.
YTDLP_PATH=

# OPTIONAL. Netscape-format cookies.txt exported from a logged-in browser.
# Used by the yt-dlp fallback; without it yt-dlp also hits the login wall.
IG_COOKIES_FILE=

# OPTIONAL. Third-party resolver API (RapidAPI style). The URL must contain
# {url} where the encoded Instagram link should be substituted.
# Example: https://instagram-scraper.p.rapidapi.com/media?url={url}
PROVIDER_URL=
PROVIDER_KEY=
PROVIDER_HOST=

# OPTIONAL. Path to a Chrome/Chromium/Edge binary for the instadl strategy.
# instadl drives a headless browser to fetch the real MP4 url for reels/posts
# (the other strategies can only return a preview image when anonymous).
# Leave empty to auto-detect an installed browser (Chrome, Chromium or Edge).
INSTADL_BROWSER=
